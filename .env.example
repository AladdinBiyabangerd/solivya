# Copy to .env.local for local dev.
# Paste the same keys into Vercel → Project → Settings → Environment Variables
# (Production + Preview), then redeploy.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Apex domain only — no protocol. Used for tenant routing:
#   solivya.homes          → marketing + /admin (owner panel)
#   {slug}.solivya.homes   → property site
# Legacy app.solivya.homes redirects to solivya.homes/admin
NEXT_PUBLIC_ROOT_DOMAIN=solivya.homes

# WhatsApp sales CTA on marketing. Prefer international digits (994…).
# Local AZ forms (077… / 77…) are normalized to 994 in code.
NEXT_PUBLIC_SALES_WHATSAPP=994501234567
