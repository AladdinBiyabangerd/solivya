# Copy to .env.local for local dev.
# Paste the same keys into Vercel → Project → Settings → Environment Variables
# (Production + Preview), then redeploy.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Apex domain only — no protocol. Used for tenant routing:
#   solivya.homes          → marketing
#   app.solivya.homes      → admin
#   {slug}.solivya.homes   → property site
NEXT_PUBLIC_ROOT_DOMAIN=solivya.homes

# WhatsApp sales CTA on marketing (digits only, country code included)
NEXT_PUBLIC_SALES_WHATSAPP=994501234567
